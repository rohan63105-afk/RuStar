# কপি করে .env নামে সেভ করুন (.env কখনো গিটহাবে তুলবেন না)
NODE_ENV=production
PORT=3000
# আপনার ডোমেইন (https সহ)। পেমেন্ট গেটওয়ে এখানেই ফিরে আসবে
BASE_URL=https://your-domain.com
# লম্বা এলোমেলো গোপন কী (কমপক্ষে ৩২ অক্ষর)। যেমন: openssl rand -hex 32
APP_SECRET=
# যাদের সব অর্ডার দেখার অনুমতি থাকবে (কমা দিয়ে)
ADMIN_PHONES=
# mock = পরীক্ষামূলক ভুয়া পেমেন্ট, sslcommerz = আসল গেটওয়ে (bKash/Nagad/কার্ড)
PAYMENT_MODE=mock
SSLC_STORE_ID=
SSLC_STORE_PASS=
# true = সত্যিকারের লাইভ, false = স্যান্ডবক্স
SSLC_LIVE=false
# SMS: আপনার SMS প্রোভাইডারের URL। {to} ও {msg} জায়গায় নম্বর ও বার্তা বসবে
# উদাহরণ: http://bulksmsbd.net/api/smsapi?api_key=KEY&type=text&number={to}&senderid=ID&message={msg}
SMS_URL_TEMPLATE=
